{
  "name": "pcif-academie-server",
  "version": "0.32.1",
  "private": true,
  "description": "Première itération serveur multi-utilisateur de PCIF Académie / EPLE Core",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "db:init": "tsx scripts/init-db.ts",
    "db:seed": "tsx scripts/seed.ts",
    "check": "tsc --noEmit",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:reference": "tsx scripts/import-pcif-267.ts",
    "db:demo-sync": "tsx scripts/sync-demo.ts",
    "db:demo-reset": "bash deploy/reset-demo.sh",
    "db:reference-check": "tsx scripts/check-reference.ts",
    "db:directory-sync": "tsx scripts/sync-education-directory.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.2.2",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.1",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "type": "module"
}
