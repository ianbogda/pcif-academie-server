[Unit]
Description=PCIF Académie Server
After=network.target postgresql.service

[Service]
Type=simple
User=pcif
Group=pcif
WorkingDirectory=/opt/pcif-academie
EnvironmentFile=/opt/pcif-academie/.env
ExecStart=/usr/bin/node /opt/pcif-academie/dist/src/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pcif-academie

[Install]
WantedBy=multi-user.target
